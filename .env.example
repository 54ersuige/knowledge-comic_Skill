# Knowledge Comic Skill - 环境变量示例
# 复制到 .env 并填入真实值。.env 不会进 git（已加 .gitignore）。

# === Agnes API（跑图后端） ===
AGNES_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AGNES_BASE_URL=https://apihub.agnes-ai.cn/v1
AGNES_MODEL=agnes-image-2.5-flash

# === LLM（分镜拆解，可选） ===
# 不配则用 mock storyboard（不依赖 LLM）
LLM_PROVIDER=minimax
LLM_API_KEY=sk-placeholder-replace-me
LLM_BASE_URL=https://api.minimax.chat/v1
LLM_MODEL=MiniMax-M3

# === 微信公众号 ===
# 申请：https://mp.weixin.qq.com → 设置与开发 → 基本配置
# 不要贴到对话里。直接打开 .env 文件填。
# IP 白名单：mp.weixin.qq.com → 设置与开发 → 基本配置 → IP 白名单
# 查公网 IP：curl https://api.ipify.org
WECHAT_APPID=wx你的AppID
WECHAT_APPSECRET=你的AppSecret
WECHAT_API_BASE=https://api.weixin.qq.com

# === 本地 ===
DATA_DIR=./data